# ==============================================================================
# Legal Snaps Infographic Generator — Environment Configuration (.env.example)
# Copy to backend/.env and fill in GEMINI_API_KEY.
# Legal analysis: Qwen via Hugging Face Inference Providers.
# Artwork: FLUX via Hugging Face Inference Providers (optional; the layout is deterministic SVG).
# ==============================================================================

# Application & Server Configuration
APP_NAME="Legal Snaps Infographic Generator"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Storage Configuration
STORAGE_DIR="./storage/artifacts"
SQLITE_DB_PATH="./storage/legal_snaps.db"

# ==============================================================================
# Hugging Face Inference Providers (single token for analysis + artwork)
# ==============================================================================
# Create a token with "Make calls to Inference Providers" permission:
# https://huggingface.co/settings/tokens
# The app also accepts a prior `hf auth login` token from ~/.cache/huggingface/token.
# Provider errors (401, 402, 429...) are reported verbatim; there is no fallback model.
HF_TOKEN="hf_your_token_here"

# Models available to this token (verified via the router's /v1/models endpoint):
#   Qwen/Qwen2.5-72B-Instruct        -> deepinfra, featherless-ai
#   black-forest-labs/FLUX.1-schnell -> fal-ai, replicate, wavespeed, nscale
# FLUX.1-dev is higher quality but non-commercial; switch by changing HF_IMAGE_MODEL.
HF_TEXT_MODEL="Qwen/Qwen2.5-72B-Instruct"
HF_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"
HF_ROUTER_BASE_URL="https://router.huggingface.co/v1"

# Search Configuration (no key required: DuckDuckGo HTML + Indian Kanoon fallback)
SEARCH_PROVIDER="duckduckgo"
SEARCH_API_KEY=""

# OCR Configuration for Scanned PDFs
OCR_PROVIDER="disabled"
TESSERACT_CMD="/opt/homebrew/bin/tesseract"

# Pipeline Limits & Timeouts
API_TIMEOUT_SECONDS=60
MAX_SOURCE_SIZE_BYTES=15000000
# Characters of the extracted judgment sent to Qwen (opening + ranked + tail excerpts)
ANALYSIS_MAX_CHARS=60000
# Longest side of the optional AI artwork image before it is embedded in the SVG
ARTWORK_MAX_SIDE=1024
